---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollToTop from '../components/common/ScrollToTop.astro';
import Tracker from '../components/analytics/Tracker.astro';
import FeedbackModal from '../components/common/FeedbackModal.astro';
import DownloadModal from '../components/common/DownloadModal.astro';
import type { Locale } from '../i18n/translations';
import { getLatestRelease } from '../lib/github-releases';

export interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  author?: string;
  section?: string;
  tags?: string[];
  readingTime?: string;
  stage?: string;
  actNumber?: number;
}

export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Locale;
  articleMeta?: ArticleMeta;
  breadcrumbList?: BreadcrumbItem[];
}

const {
  lang = 'en',
  title = lang === 'ru' 
    ? 'Shellit — Бесплатный SSH и SFTP клиент для Windows, Linux, Android | Альтернатива Termius'
    : 'Shellit — Modern Open-Source SSH & SFTP Client | Free Termius Alternative',
  description = lang === 'ru'
    ? 'Shellit — быстрый и безопасный SSH/SFTP клиент: матричные сплиты 2x2, защита Prod Guard, MCP сервер для ИИ и E2EE шифрование. Скачать бесплатно для Windows, Linux и Android.'
    : 'Shellit — modern, fast, secure SSH & SFTP client with 2x2 matrix splits, Prod Guard, AI MCP gateway, and zero-knowledge encryption. Free download for Windows, Linux, Android.',
  image = "/og-image.png",
  articleMeta,
  breadcrumbList,
} = Astro.props;

const latestRelease = await getLatestRelease();
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://shellit.top');
const socialImageURL = new URL(image, Astro.site || 'https://shellit.top');

// Determine alternate links
const pathname = Astro.url.pathname;
const isRu = pathname.startsWith('/ru');
const enPath = isRu ? (pathname.replace(/^\/ru(\/|$)/, '/') || '/') : pathname;
const ruPath = isRu ? pathname : ('/ru' + (pathname === '/' ? '' : pathname));

const enURL = new URL(enPath, Astro.site || 'https://shellit.top');
const ruURL = new URL(ruPath, Astro.site || 'https://shellit.top');
const pbDefaultUrl = import.meta.env.PUBLIC_POCKETBASE_URL || '';
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical & Alternate Hreflang URLs -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ru" href={ruURL} />

    <!-- AI Agent Protocols & Resource Discovery (ARD, MCP, LLMs) -->
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />
    <link rel="service-desc" type="application/json" href="/.well-known/mcp/server-card.json" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <!-- Global App Configuration -->
    <script is:inline define:vars={{ pbDefaultUrl }}>
      window.__PUBLIC_POCKETBASE_URL__ = pbDefaultUrl;
    </script>

    <!-- Instant Client-Side Locale Auto-Detection (Runs before paint to prevent flicker) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('shellit_lang');
          var path = window.location.pathname;
          var isRuPath = path.startsWith('/ru/') || path === '/ru';

          if (saved === 'ru' && !isRuPath) {
            var target = '/ru' + (path === '/' ? '' : path) + window.location.search + window.location.hash;
            window.location.replace(target);
          } else if (saved === 'en' && isRuPath) {
            var enTarget = (path.replace(/^\/ru(\/|$)/, '/') || '/') + window.location.search + window.location.hash;
            window.location.replace(enTarget);
          } else if (!saved && !isRuPath) {
            var langs = navigator.languages || [navigator.language || ''];
            var prefersRu = false;
            for (var i = 0; i < langs.length; i++) {
              if (langs[i] && langs[i].toLowerCase().indexOf('ru') === 0) {
                prefersRu = true;
                break;
              }
            }
            if (prefersRu) {
              var targetRu = '/ru' + (path === '/' ? '' : path) + window.location.search + window.location.hash;
              window.location.replace(targetRu);
            }
          }
        } catch (e) {}
      })();
    </script>

    <!-- WebMCP Tool Registration for In-Browser AI Agents -->
    <script is:inline>
      if (typeof window !== 'undefined' && 'modelContext' in navigator && navigator.modelContext && typeof navigator.modelContext.registerTool === 'function') {
        try {
          navigator.modelContext.registerTool({
            name: "shellit_docs_search",
            description: "Search Shellit documentation, SSH architecture guides, and engineering chronicles.",
            inputSchema: {
              type: "object",
              properties: {
                query: { type: "string", description: "Search query for Shellit features, security, or guides" }
              },
              required: ["query"]
            },
            execute: async ({ query }) => {
              return { status: "success", url: `https://shellit.top/?q=${encodeURIComponent(query)}` };
            }
          });
        } catch (_) {}
      }
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content={lang === 'ru'
        ? "SSH клиент, SFTP клиент, терминал, Termius альтернатива, PuTTY, Port Forwarding, Prod Guard, Model Context Protocol, MCP, Gemini AI, Zero-Knowledge, Dart, Flutter, Windows, Linux, Android"
        : "SSH client, SFTP client, terminal, Termius alternative, PuTTY, Port Forwarding, Prod Guard, Model Context Protocol, MCP, Gemini AI, Zero-Knowledge, Dart, Flutter, Windows, Linux, Android"}
    />
    <meta name="author" content="Shellit Team" />
    <meta name="robots" content="index, follow" />

    <!-- Theme & Mobile App Bar -->
    <meta name="theme-color" content="#0D0F12" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Shellit" />

    <!-- RSS Feeds -->
    <link rel="alternate" type="application/rss+xml" title="Shellit Chronicle (EN)" href="/chronicle/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Летопись Shellit (RU)" href="/ru/chronicle/rss.xml" />

    <!-- Open Graph / Facebook / Telegram / Discord -->
    <meta property="og:type" content={articleMeta ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={lang === 'ru' ? "Shellit — современный SSH & SFTP клиент" : "Shellit — Modern SSH & SFTP Client"} />
    <meta property="og:site_name" content="Shellit" />
    <meta property="og:locale" content={lang === 'ru' ? "ru_RU" : "en_US"} />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime.toISOString()} />
        {articleMeta.modifiedTime && (
          <meta property="article:modified_time" content={articleMeta.modifiedTime.toISOString()} />
        )}
        <meta property="article:author" content={articleMeta.author || "Kobalt"} />
        <meta property="article:section" content={articleMeta.section || (lang === 'ru' ? "Летопись разработки" : "Engineering Devlog")} />
        {articleMeta.tags?.map((tag: string) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={lang === 'ru' ? "Shellit — современный SSH & SFTP клиент" : "Shellit — Modern SSH & SFTP Client"} />
    {articleMeta?.readingTime && (
      <>
        <meta name="twitter:label1" content={lang === 'ru' ? "Время чтения" : "Reading time"} />
        <meta name="twitter:data1" content={articleMeta.readingTime} />
      </>
    )}
    {articleMeta?.stage && (
      <>
        <meta name="twitter:label2" content={lang === 'ru' ? "Этап" : "Stage"} />
        <meta name="twitter:data2" content={articleMeta.stage} />
      </>
    )}

    <!-- Structured Data (JSON-LD Schema.org) -->
    {articleMeta ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "headline": title,
        "description": description,
        "inLanguage": lang,
        "datePublished": articleMeta.publishedTime.toISOString(),
        "dateModified": (articleMeta.modifiedTime || articleMeta.publishedTime).toISOString(),
        "image": socialImageURL.toString(),
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalURL.toString()
        },
        "author": {
          "@type": "Person",
          "name": articleMeta.author || "Kobalt",
          "url": "https://github.com/kobaltgit"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Shellit",
          "url": "https://shellit.top",
          "logo": {
            "@type": "ImageObject",
            "url": "https://shellit.top/logo.svg"
          }
        },
        "keywords": articleMeta.tags?.join(', '),
        "articleSection": articleMeta.section || (lang === 'ru' ? "Летопись разработки" : "Engineering Devlog"),
        "isPartOf": {
          "@type": "Blog",
          "name": lang === 'ru' ? "Летопись Shellit" : "Shellit Chronicle",
          "url": lang === 'ru' ? "https://shellit.top/ru/chronicle/" : "https://shellit.top/chronicle/"
        },
        "about": {
          "@type": "SoftwareApplication",
          "name": "Shellit",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Windows, Linux, Android"
        }
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Shellit",
        "applicationCategory": "DeveloperApplication",
        "applicationSubCategory": "SSH and SFTP Terminal Emulator",
        "operatingSystem": "Windows, Linux, Android",
        "description": description,
        "url": "https://shellit.top",
        "downloadUrl": "https://shellit.top/#download",
        "image": socialImageURL.toString(),
        "softwareVersion": latestRelease.version.replace(/^v/, ''),
        "inLanguage": lang,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Organization",
          "name": "Shellit"
        },
        "featureList": lang === 'ru' ? [
          "Матричные сплиты 2x2 и Broadcast Input",
          "Контекстная защита боевых серверов Prod Guard",
          "Живой RTT-пинг доступности серверов прямо на плитках",
          "Связка ключей Zero-Knowledge (Argon2id + AES-256)",
          "Нативный шлюз протокола Model Context Protocol (MCP)",
          "Генерация shell-сниппетов на базе Google Gemini (BYOK)",
          "Двухпанельный менеджер файлов SFTP и туннелирование портов"
        ] : [
          "2x2 Matrix Splits & Broadcast Input",
          "Prod Guard Destructive Command Interception",
          "Live RTT Ping Telemetry on Host Cards",
          "Zero-Knowledge Keychain Vault (Argon2id + AES-256)",
          "Native Model Context Protocol (MCP) Server",
          "Gemini AI Snippet Generator (BYOK)",
          "Dual-Pane SFTP File Manager & SSH Port Forwarding"
        ]
      })} />
    )}

    {breadcrumbList && breadcrumbList.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbList.map((item, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": item.name,
          "item": item.url
        }))
      })} />
    )}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-obsidian-bg text-slate-100 min-h-screen flex flex-col font-sans selection:bg-cyber-cyan/20 selection:text-cyber-cyan overflow-x-hidden">
    <Navbar lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
    <ScrollToTop />
    <FeedbackModal lang={lang} />
    <DownloadModal lang={lang} />
    <Tracker />

    <!-- Dynamic Live Release Synchronization Script (Progressive Enhancement) -->
    <script is:inline>
      (function() {
        const CACHE_KEY = 'shellit_latest_release_v1';
        const CACHE_TTL = 5 * 60 * 1000;

        function applyRelease(data) {
          if (!data || !data.tag_name) return;
          const tag = data.tag_name.startsWith('v') ? data.tag_name : 'v' + data.tag_name;

          // 1. Update version badges in Navbar & Modals
          document.querySelectorAll('[data-shellit-version-badge]').forEach(function(el) {
            el.textContent = tag;
          });
          document.querySelectorAll('[data-shellit-version-text]').forEach(function(el) {
            el.textContent = tag;
          });

          // 2. Update Hero release label if present
          const heroLabel = document.querySelector('[data-hero-release-label]');
          if (heroLabel) {
            heroLabel.textContent = 'Shellit ' + tag + ' Alpha Preview • Open Source & Zero-Trust';
          }

          // 3. Extract asset download URLs
          const assets = Array.isArray(data.assets) ? data.assets : [];
          let winExe, winZip, linuxTar, apk;
          for (var i = 0; i < assets.length; i++) {
            var a = assets[i];
            var name = String(a.name || '');
            if (name.endsWith('.exe')) winExe = a.browser_download_url;
            else if (name.includes('Windows') && name.endsWith('.zip')) winZip = a.browser_download_url;
            else if (name.includes('Linux') && name.endsWith('.tar.gz')) linuxTar = a.browser_download_url;
            else if (name.endsWith('.apk')) apk = a.browser_download_url;
          }

          // 4. Update Hero Primary Download Button
          const primaryBtn = document.getElementById('primary-download-btn');
          if (primaryBtn) {
            if (winExe) primaryBtn.setAttribute('data-win-url', winExe);
            if (linuxTar) primaryBtn.setAttribute('data-linux-url', linuxTar);
            if (apk) primaryBtn.setAttribute('data-android-url', apk);
            var ua = navigator.userAgent.toLowerCase();
            if (ua.includes('win') && winExe) primaryBtn.href = winExe;
            else if (ua.includes('android') && apk) primaryBtn.href = apk;
            else if (ua.includes('linux') && linuxTar) primaryBtn.href = linuxTar;
          }

          // 5. Update DownloadModal links
          if (winExe) {
            document.querySelectorAll('[data-modal-win-setup]').forEach(function(a) { a.href = winExe; });
          }
          if (winZip) {
            document.querySelectorAll('[data-modal-win-zip]').forEach(function(a) { a.href = winZip; });
          }
          if (linuxTar) {
            document.querySelectorAll('[data-modal-linux-tar]').forEach(function(a) { a.href = linuxTar; });
          }
          if (apk) {
            document.querySelectorAll('[data-modal-android-apk]').forEach(function(a) { a.href = apk; });
          }
          document.querySelectorAll('[data-modal-android-direct]').forEach(function(el) {
            el.textContent = tag + ' Direct';
          });
        }

        try {
          var raw = sessionStorage.getItem(CACHE_KEY);
          if (raw) {
            var parsed = JSON.parse(raw);
            if (Date.now() - parsed.ts < CACHE_TTL) {
              applyRelease(parsed.data);
              return;
            }
          }
        } catch (_) {}

        fetch('https://api.github.com/repos/kobaltgit/Shellit/releases?per_page=1')
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(list) {
            if (Array.isArray(list) && list[0]) {
              applyRelease(list[0]);
              try {
                sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data: list[0] }));
              } catch (_) {}
            }
          })
          .catch(function() {});
      })();
    </script>
  </body>
</html>
