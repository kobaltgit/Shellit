---
import { Bot, Cpu, KeyRound, Sparkles, Terminal, ArrowRight, Shield } from 'lucide-astro';
import type { Locale } from '../../i18n/translations';
import { useTranslations } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'ru' ? '/ru' : '';
---

<section id="ai" class="py-20 bg-obsidian-card/30 border-t border-obsidian-border/80 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-obsidian-card border border-obsidian-border text-xs font-mono text-cyber-purple mb-3">
        <Sparkles class="w-3.5 h-3.5" />
        <span>{t.aiMcp.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {t.aiMcp.title}
      </h2>
      <p class="mt-3 text-slate-400 text-sm sm:text-base">
        {t.aiMcp.subtitle}
      </p>
    </div>

    <!-- Dual Pillar Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Card 1: AI Snippets Chat (BYOK) -->
      <div class="rounded-2xl bg-obsidian-card border border-obsidian-border p-6 sm:p-8 space-y-5 relative overflow-hidden group hover:border-cyber-purple/50 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-cyber-purple/10 border border-cyber-purple/30 flex items-center justify-center text-cyber-purple">
          <Bot class="w-6 h-6" />
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white">
          {t.aiMcp.card1Title}
        </h3>

        <p class="text-slate-300 text-sm leading-relaxed">
          {t.aiMcp.card1Desc}
        </p>

        <ul class="space-y-2.5 text-xs text-slate-300 pt-2 font-mono">
          <li class="flex items-center gap-2">
            <KeyRound class="w-4 h-4 text-cyber-purple flex-shrink-0" />
            <span>{t.aiMcp.card1Bullet1}</span>
          </li>
          <li class="flex items-center gap-2">
            <Sparkles class="w-4 h-4 text-cyber-purple flex-shrink-0" />
            <span>{t.aiMcp.card1Bullet2}</span>
          </li>
          <li class="flex items-center gap-2">
            <Terminal class="w-4 h-4 text-cyber-purple flex-shrink-0" />
            <span>{t.aiMcp.card1Bullet3}</span>
          </li>
        </ul>

        <!-- Real Gemini Snippets Chat Screenshot -->
        <div class="rounded-xl overflow-hidden border border-obsidian-border bg-obsidian-bg/80 p-1.5 shadow-xl">
          <div class="flex items-center justify-between px-3 py-1.5 bg-obsidian-surface/60 rounded-t-lg border-b border-obsidian-border text-[10px] font-mono text-slate-400 mb-1.5">
            <span>AI Snippet Assistant</span>
            <span class="text-cyber-purple font-semibold">gemini-3.1-flash-lite</span>
          </div>
          <img
            src="/screenshots/05_gemini_ai_chat.png"
            alt="Shellit Gemini AI Snippet Chat Assistant"
            class="w-full h-auto object-cover rounded-md"
            loading="lazy"
          />
        </div>

        <div class="pt-2 text-xs font-mono text-slate-500">
          <span>{t.aiMcp.card1Footer}</span>
        </div>
      </div>

      <!-- Card 2: Model Context Protocol (MCP Gateway) -->
      <div class="rounded-2xl bg-obsidian-card border border-obsidian-border p-6 sm:p-8 space-y-5 relative overflow-hidden group hover:border-cyber-cyan/50 transition-colors">
        <div class="w-12 h-12 rounded-xl bg-cyber-cyan/10 border border-cyber-cyan/30 flex items-center justify-center text-cyber-cyan">
          <Cpu class="w-6 h-6" />
        </div>

        <h3 class="text-xl sm:text-2xl font-bold text-white">
          {t.aiMcp.card2Title}
        </h3>

        <p class="text-slate-300 text-sm leading-relaxed">
          {t.aiMcp.card2Desc}
        </p>

        <ul class="space-y-2.5 text-xs text-slate-300 pt-2 font-mono">
          <li class="flex items-center gap-2">
            <Terminal class="w-4 h-4 text-cyber-cyan flex-shrink-0" />
            <span>{t.aiMcp.card2Bullet1}</span>
          </li>
          <li class="flex items-center gap-2">
            <Shield class="w-4 h-4 text-cyber-cyan flex-shrink-0" />
            <span>{t.aiMcp.card2Bullet2}</span>
          </li>
          <li class="flex items-center gap-2">
            <Cpu class="w-4 h-4 text-cyber-cyan flex-shrink-0" />
            <span>{t.aiMcp.card2Bullet3}</span>
          </li>
        </ul>

        <!-- Real MCP Server Diagnostics Screenshot -->
        <div class="rounded-xl overflow-hidden border border-obsidian-border bg-obsidian-bg/80 p-1.5 shadow-xl">
          <div class="flex items-center justify-between px-3 py-1.5 bg-obsidian-surface/60 rounded-t-lg border-b border-obsidian-border text-[10px] font-mono text-slate-400 mb-1.5">
            <span>MCP Protocol Diagnostics</span>
            <span class="text-cyber-green font-semibold">Active Server (Port 8765)</span>
          </div>
          <img
            src="/screenshots/09_mcp_server_gateway.png"
            alt="Shellit Native Model Context Protocol MCP Server"
            class="w-full h-auto object-cover rounded-md"
            loading="lazy"
          />
        </div>

        <div class="pt-2">
          <a
            href={`${basePath}/ai/mcp-server`}
            class="inline-flex items-center gap-2 text-cyber-cyan text-xs font-mono hover:underline group"
          >
            <span>{t.aiMcp.card2Footer}</span>
            <ArrowRight class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
