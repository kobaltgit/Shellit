---
const currentLocale = Astro.locals.starlightRoute.locale;
const currentPath = Astro.url.pathname;

let enPath = currentPath;
let ruPath = currentPath;

if (currentLocale === 'ru') {
  enPath = currentPath.replace(/^\/ru(\/|$)/, '/') || '/';
} else {
  ruPath = '/ru' + (currentPath === '/' ? '' : currentPath);
}
---

<div class="starlight-custom-lang" style="display: flex; align-items: center; border-radius: 0.5rem; background: #14171E; border: 1px solid #1E2430; padding: 2px; font-family: monospace; font-size: 0.75rem;">
  <a
    href={enPath}
    class="lang-pill"
    style={`display: inline-block; padding: 0.2rem 0.6rem; border-radius: 0.375rem; text-decoration: none; font-size: 0.72rem; transition: all 0.2s; ${
      currentLocale !== 'ru'
        ? 'background: rgba(123,225,19,0.15); color: #7BE113; font-weight: 700; border: 1px solid rgba(123,225,19,0.3); box-shadow: 0 0 8px rgba(123,225,19,0.2);'
        : 'color: #94A3B8; border: 1px solid transparent;'
    }`}
    title="English documentation"
  >
    EN
  </a>
  <a
    href={ruPath}
    class="lang-pill"
    style={`display: inline-block; padding: 0.2rem 0.6rem; border-radius: 0.375rem; text-decoration: none; font-size: 0.72rem; transition: all 0.2s; ${
      currentLocale === 'ru'
        ? 'background: rgba(123,225,19,0.15); color: #7BE113; font-weight: 700; border: 1px solid rgba(123,225,19,0.3); box-shadow: 0 0 8px rgba(123,225,19,0.2);'
        : 'color: #94A3B8; border: 1px solid transparent;'
    }`}
    title="Документация на русском"
  >
    RU
  </a>
</div>

<style>
  .lang-pill:hover {
    color: #FFFFFF !important;
  }
</style>
