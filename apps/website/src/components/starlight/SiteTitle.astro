---
const { siteTitleHref } = Astro.locals.starlightRoute;
const isRu = Astro.locals.starlightRoute.locale === 'ru';
const homeHref = isRu ? '/ru' : '/';
---

<div class="site-title-wrapper" style="display: flex; align-items: center; gap: 0.75rem;">
  <a href={siteTitleHref} class="site-title-brand" style="display: flex; align-items: center; gap: 0.65rem; text-decoration: none;">
    <div style="width: 2rem; height: 2rem; border-radius: 0.5rem; background: #14171E; border: 1px solid #1E2430; display: flex; align-items: center; justify-content: center; padding: 0.25rem; box-shadow: 0 0 12px rgba(123,225,19,0.3); flex-shrink: 0;">
      <img src="/favicon.svg" alt="Shellit Logo" style="width: 100%; height: 100%; object-fit: contain;" width="24" height="24" />
    </div>
    <div style="display: flex; align-items: center; gap: 0.45rem;">
      <span style="font-weight: 700; font-size: 1.05rem; color: #FFFFFF; letter-spacing: 0.02em;">Shellit</span>
      <span style="font-size: 0.68rem; font-family: monospace; font-weight: 600; color: #7BE113; background: rgba(123,225,19,0.12); border: 1px solid rgba(123,225,19,0.3); padding: 0.1rem 0.4rem; border-radius: 0.25rem;">Docs</span>
    </div>
  </a>

  <a
    href={homeHref}
    class="back-to-portal-link"
    style="display: inline-flex; align-items: center; gap: 0.3rem; margin-left: 0.4rem; padding: 0.2rem 0.55rem; border-radius: 0.375rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); color: #94A3B8; font-size: 0.72rem; font-family: monospace; text-decoration: none; transition: all 0.2s;"
    title={isRu ? "Вернуться на главную Shellit" : "Back to Shellit main portal"}
  >
    <span>←</span>
    <span>{isRu ? "Портал" : "Portal"}</span>
  </a>
</div>

<style>
  .back-to-portal-link:hover {
    color: #FFFFFF !important;
    border-color: rgba(123,225,19,0.4) !important;
    background: rgba(123,225,19,0.1) !important;
  }
</style>
