---
import { Github, Shield } from 'lucide-astro';
import type { Locale } from '../../i18n/translations';
import { useTranslations } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'ru' ? '/ru' : '';
---

<footer class="border-t border-obsidian-border bg-obsidian-card/60 backdrop-blur-sm mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand column -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-obsidian-surface border border-obsidian-border flex items-center justify-center p-1 shadow-glow-cyan">
            <img src="/favicon.svg" alt="Shellit Logo" class="w-full h-full" />
          </div>
          <span class="font-bold text-lg text-white">Shellit</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {t.footer.desc}
        </p>
        <div class="flex items-center gap-2 text-[11px] text-slate-500 font-mono">
          <Shield class="w-3.5 h-3.5 text-cyber-cyan" />
          <span>Zero-Knowledge Vault (Argon2id)</span>
        </div>
      </div>

      <!-- Nav Col 1: Product -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-200">{t.footer.navTitle}</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href={`${basePath}/#features`} class="hover:text-cyber-cyan transition-colors">{t.footer.navMatrix}</a></li>
          <li><a href={`${basePath}/#features`} class="hover:text-cyber-cyan transition-colors">{t.footer.navProdGuard}</a></li>
          <li><a href={`${basePath}/#compare`} class="hover:text-cyber-cyan transition-colors">{t.footer.navCompare}</a></li>
          <li><a href={`${basePath}/#sync`} class="hover:text-cyber-cyan transition-colors">{t.footer.navSync}</a></li>
          <li><a href={`${basePath}/roadmap`} class="hover:text-cyber-cyan transition-colors">{t.footer.navRoadmap}</a></li>
        </ul>
      </div>

      <!-- Nav Col 2: Knowledge Base -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-200">{t.footer.resourcesTitle}</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href={`${basePath}/getting-started/quick-start`} class="hover:text-cyber-cyan transition-colors">{t.footer.quickStart}</a></li>
          <li><a href={`${basePath}/getting-started/installation`} class="hover:text-cyber-cyan transition-colors">{t.footer.installation}</a></li>
          <li><a href={`${basePath}/sync/docker-deployment`} class="hover:text-cyber-cyan transition-colors">{t.footer.syncDeploy}</a></li>
          <li><a href={`${basePath}/security/prod-guard`} class="hover:text-cyber-cyan transition-colors">{t.footer.prodGuardSetup}</a></li>
          <li><a href={`${basePath}/plugins/creating-plugins`} class="hover:text-cyber-cyan transition-colors">{t.footer.pluginDev}</a></li>
        </ul>
      </div>

      <!-- Nav Col 3: Open Source -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-200">{t.footer.communityTitle}</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>
            <a href="https://github.com/kobaltgit/Shellit" target="_blank" rel="noopener noreferrer" class="hover:text-cyber-cyan transition-colors flex items-center gap-1.5">
              <Github class="w-3.5 h-3.5" /> {t.footer.github}
            </a>
          </li>
          <li><a href="https://github.com/kobaltgit/Shellit/releases" target="_blank" rel="noopener noreferrer" class="hover:text-cyber-cyan transition-colors">{t.footer.releases}</a></li>
          <li><a href="https://github.com/kobaltgit/Shellit/issues" target="_blank" rel="noopener noreferrer" class="hover:text-cyber-cyan transition-colors">{t.footer.issues}</a></li>
          <li><a href={`${basePath}/ai/mcp-server`} class="hover:text-cyber-cyan transition-colors">{t.footer.mcpDoc}</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="pt-8 border-t border-obsidian-border/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-cyber-green animate-pulse"></span>
        <span>{t.footer.rights}</span>
      </div>
      <div class="flex items-center gap-1 font-mono text-[11px]">
        <span>{t.footer.builtWith}</span>
      </div>
    </div>
  </div>
</footer>
