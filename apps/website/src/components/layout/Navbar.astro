---
import {
  Github,
  Download,
  Menu,
  X,
  ChevronDown,
  Terminal,
  ArrowLeftRight,
  RefreshCw,
  Bot,
  Star,
  Map,
  BookOpen,
} from 'lucide-astro';
import type { Locale } from '../../i18n/translations';
import { useTranslations } from '../../i18n/translations';
import { getLatestRelease, getRepoStars } from '../../lib/github-releases';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'ru' ? '/ru' : '';
const latestRelease = await getLatestRelease();
const repoStars = await getRepoStars();
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-obsidian-bg/90 border-b border-obsidian-border/70 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Left: Logo + Version Tag -->
    <div class="flex items-center gap-6">
      <a href={basePath || '/'} class="flex items-center gap-3 group">
        <div class="relative w-9 h-9 rounded-xl bg-obsidian-card border border-obsidian-border flex items-center justify-center p-1.5 shadow-glow-cyan transition-transform group-hover:scale-105">
          <img src="/favicon.svg" alt="Shellit Logo" class="w-full h-full" />
        </div>
        <div class="flex items-center gap-2">
          <span class="font-bold text-lg tracking-wide text-white group-hover:text-cyber-cyan transition-colors">Shellit</span>
          <span class="px-2 py-0.5 text-[11px] font-mono font-medium rounded-full bg-cyber-cyan/10 text-cyber-cyan border border-cyber-cyan/30 hover:bg-cyber-cyan/20 transition-colors">
            {latestRelease.version}
          </span>
        </div>
      </a>
    </div>

    <!-- Center: Desktop Navigation with Product Dropdown -->
    <nav class="hidden md:flex items-center gap-1.5 text-sm font-medium" id="main-nav">
      <!-- Product Dropdown -->
      <div class="relative group/nav-dropdown" id="product-dropdown-container">
        <button
          type="button"
          id="product-dropdown-btn"
          class="nav-item flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all cursor-pointer whitespace-nowrap"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>{t.nav.product}</span>
          <ChevronDown class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200 group-hover/nav-dropdown:rotate-180 group-focus-within/nav-dropdown:rotate-180" id="product-dropdown-chevron" />
        </button>

        <!-- Dropdown Menu Panel (Stripe/Supabase style rich 2x2 grid) -->
        <div
          id="product-dropdown-menu"
          class="absolute top-full left-0 mt-2 w-[460px] p-2.5 rounded-2xl bg-obsidian-card/95 backdrop-blur-2xl border border-obsidian-border/90 shadow-2xl shadow-black/70 opacity-0 translate-y-2 pointer-events-none group-hover/nav-dropdown:opacity-100 group-hover/nav-dropdown:translate-y-0 group-hover/nav-dropdown:pointer-events-auto group-focus-within/nav-dropdown:opacity-100 group-focus-within/nav-dropdown:translate-y-0 group-focus-within/nav-dropdown:pointer-events-auto transition-all duration-200 z-50 before:absolute before:-top-3 before:left-0 before:right-0 before:h-3 before:content-['']"
        >
          <div class="grid grid-cols-2 gap-1.5">
            <!-- Features -->
            <a
              href={`${basePath}/#features`}
              data-nav-target="features"
              class="dropdown-link flex items-start gap-3 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-cyber-cyan/10 border border-cyber-cyan/25 flex items-center justify-center text-cyber-cyan group-hover/item:scale-105 group-hover/item:bg-cyber-cyan/20 transition-all shrink-0 mt-0.5">
                <Terminal class="w-4 h-4" />
              </div>
              <div>
                <div class="text-xs font-semibold text-white group-hover/item:text-cyber-cyan transition-colors">{t.nav.features}</div>
                <div class="text-[11px] text-slate-400 leading-snug mt-0.5">{t.nav.featuresDesc}</div>
              </div>
            </a>

            <!-- Compare -->
            <a
              href={`${basePath}/#compare`}
              data-nav-target="compare"
              class="dropdown-link flex items-start gap-3 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/25 flex items-center justify-center text-amber-400 group-hover/item:scale-105 group-hover/item:bg-amber-500/20 transition-all shrink-0 mt-0.5">
                <ArrowLeftRight class="w-4 h-4" />
              </div>
              <div>
                <div class="text-xs font-semibold text-white group-hover/item:text-amber-400 transition-colors">{t.nav.compare}</div>
                <div class="text-[11px] text-slate-400 leading-snug mt-0.5">{t.nav.compareDesc}</div>
              </div>
            </a>

            <!-- Sync Server -->
            <a
              href={`${basePath}/#sync`}
              data-nav-target="sync"
              class="dropdown-link flex items-start gap-3 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center text-emerald-400 group-hover/item:scale-105 group-hover/item:bg-emerald-500/20 transition-all shrink-0 mt-0.5">
                <RefreshCw class="w-4 h-4" />
              </div>
              <div>
                <div class="text-xs font-semibold text-white group-hover/item:text-emerald-400 transition-colors">{t.nav.sync}</div>
                <div class="text-[11px] text-slate-400 leading-snug mt-0.5">{t.nav.syncDesc}</div>
              </div>
            </a>

            <!-- AI & MCP -->
            <a
              href={`${basePath}/#ai`}
              data-nav-target="ai"
              class="dropdown-link flex items-start gap-3 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item"
            >
              <div class="w-8 h-8 rounded-lg bg-purple-500/10 border border-purple-500/25 flex items-center justify-center text-purple-400 group-hover/item:scale-105 group-hover/item:bg-purple-500/20 transition-all shrink-0 mt-0.5">
                <Bot class="w-4 h-4" />
              </div>
              <div>
                <div class="text-xs font-semibold text-white group-hover/item:text-purple-400 transition-colors">{t.nav.ai}</div>
                <div class="text-[11px] text-slate-400 leading-snug mt-0.5">{t.nav.aiDesc}</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Roadmap -->
      <a
        href={`${basePath}/roadmap`}
        data-nav-target="roadmap"
        class="nav-item px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all whitespace-nowrap"
      >
        {t.nav.roadmap}
      </a>

      <!-- Docs -->
      <a
        href={`${basePath}/getting-started/quick-start`}
        data-nav-target="docs"
        class="nav-item px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-all whitespace-nowrap"
      >
        {t.nav.docs}
      </a>
    </nav>

    <!-- Right: Desktop Actions -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Language Switcher: Sleek pill -->
      <div class="flex items-center rounded-lg bg-obsidian-card/90 border border-obsidian-border/80 p-0.5 text-xs font-mono">
        <button
          type="button"
          class={`lang-switch-btn px-2.5 py-1 rounded-md transition-all cursor-pointer ${
            lang === 'en'
              ? 'bg-cyber-cyan/15 text-cyber-cyan font-bold border border-cyber-cyan/30 shadow-sm'
              : 'text-slate-400 hover:text-white'
          }`}
          data-target-lang="en"
          title="Switch to English"
        >
          EN
        </button>
        <button
          type="button"
          class={`lang-switch-btn px-2.5 py-1 rounded-md transition-all cursor-pointer ${
            lang === 'ru'
              ? 'bg-cyber-cyan/15 text-cyber-cyan font-bold border border-cyber-cyan/30 shadow-sm'
              : 'text-slate-400 hover:text-white'
          }`}
          data-target-lang="ru"
          title="Переключить на русский"
        >
          RU
        </button>
      </div>

      <!-- GitHub -->
      <a
        href="https://github.com/kobaltgit/Shellit"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-obsidian-card/90 border border-obsidian-border/80 hover:border-slate-500/70 hover:bg-white/5 text-slate-300 hover:text-white transition-all text-xs font-medium group"
        title={t.nav.githubTitle}
      >
        <Github class="w-4 h-4 text-slate-400 group-hover:text-white transition-colors" />
        <span class="font-mono">GitHub</span>
        <span class="flex items-center gap-1 text-[11px] text-slate-400 font-mono pl-1.5 border-l border-obsidian-border">
          <Star class="w-3 h-3 text-amber-400 fill-amber-400/20" />
          <span id="github-stars-count">{repoStars}</span>
        </span>
      </a>

      <!-- Download CTA (Opens Platform Modal) -->
      <button
        type="button"
        data-open-download-modal
        class="flex items-center gap-2 px-4 py-1.5 rounded-lg bg-gradient-to-r from-[#5FB300] to-[#8AEB1A] hover:from-[#549E00] hover:to-[#9EF832] text-slate-950 font-bold text-xs tracking-wide shadow-glow-cyan transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
      >
        <Download class="w-3.5 h-3.5 stroke-[2.5]" />
        <span>{t.nav.download}</span>
      </button>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Mobile Language Switcher Quick Pill -->
      <div class="flex items-center rounded-lg bg-obsidian-card border border-obsidian-border p-0.5 text-xs font-mono">
        <button
          type="button"
          class={`lang-switch-btn px-2 py-0.5 rounded transition-all text-[11px] ${
            lang === 'en'
              ? 'bg-cyber-cyan/20 text-cyber-cyan font-bold border border-cyber-cyan/40'
              : 'text-slate-400'
          }`}
          data-target-lang="en"
        >
          EN
        </button>
        <button
          type="button"
          class={`lang-switch-btn px-2 py-0.5 rounded transition-all text-[11px] ${
            lang === 'ru'
              ? 'bg-cyber-cyan/20 text-cyber-cyan font-bold border border-cyber-cyan/40'
              : 'text-slate-400'
          }`}
          data-target-lang="ru"
        >
          RU
        </button>
      </div>

      <button
        id="mobile-menu-btn"
        class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-obsidian-card cursor-pointer"
        aria-label="Toggle navigation menu"
      >
        <Menu class="w-6 h-6" id="menu-icon-open" />
        <X class="w-6 h-6 hidden" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-obsidian-border bg-obsidian-card/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-4 text-sm">
    <!-- Product Section -->
    <div>
      <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 px-2 mb-1.5">{t.nav.product}</div>
      <div class="space-y-1">
        <a href={`${basePath}/#features`} data-nav-target="features" class="mobile-nav-item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <Terminal class="w-4 h-4 text-cyber-cyan" />
          <span>{t.nav.features}</span>
        </a>
        <a href={`${basePath}/#compare`} data-nav-target="compare" class="mobile-nav-item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <ArrowLeftRight class="w-4 h-4 text-amber-400" />
          <span>{t.nav.compare}</span>
        </a>
        <a href={`${basePath}/#sync`} data-nav-target="sync" class="mobile-nav-item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <RefreshCw class="w-4 h-4 text-emerald-400" />
          <span>{t.nav.sync}</span>
        </a>
        <a href={`${basePath}/#ai`} data-nav-target="ai" class="mobile-nav-item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
          <Bot class="w-4 h-4 text-purple-400" />
          <span>{t.nav.ai}</span>
        </a>
      </div>
    </div>

    <!-- General Links -->
    <div class="border-t border-obsidian-border/60 pt-2 space-y-1">
      <a href={`${basePath}/roadmap`} data-nav-target="roadmap" class="mobile-nav-item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
        <Map class="w-4 h-4 text-cyber-cyan" />
        <span>{t.nav.roadmap}</span>
      </a>
      <a href={`${basePath}/getting-started/quick-start`} data-nav-target="docs" class="mobile-nav-item flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition-colors">
        <BookOpen class="w-4 h-4 text-cyber-cyan" />
        <span>{t.nav.docs}</span>
      </a>
    </div>

    <!-- Mobile Actions -->
    <div class="pt-2 flex flex-col gap-2">
      <a
        href="https://github.com/kobaltgit/Shellit"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-2 rounded-lg bg-obsidian-surface border border-obsidian-border text-slate-300 text-xs font-mono"
      >
        <Github class="w-4 h-4" />
        <span>GitHub</span>
        <span class="flex items-center gap-1 text-slate-400 pl-1.5 border-l border-obsidian-border">
          <Star class="w-3 h-3 text-amber-400 fill-amber-400/20" />
          <span class="github-stars-count-mobile">{repoStars}</span>
        </span>
      </a>
      <button
        type="button"
        data-open-download-modal
        class="flex items-center justify-center gap-2 py-2 rounded-lg bg-gradient-to-r from-[#5FB300] to-[#8AEB1A] text-slate-950 font-bold text-xs shadow-glow-cyan cursor-pointer w-full"
      >
        <Download class="w-4 h-4" /> {t.nav.download} Shellit
      </button>
    </div>
  </div>
</header>

<script>
  // 1. Mobile Menu Toggling
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  // Close mobile menu on clicking any mobile link
  document.querySelectorAll('.mobile-nav-item').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  // 2. Language Switcher Action
  const langButtons = document.querySelectorAll('.lang-switch-btn');
  langButtons.forEach((button) => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      const targetLang = button.getAttribute('data-target-lang');
      if (!targetLang) return;

      localStorage.setItem('shellit_lang', targetLang);
      const currentPath = window.location.pathname;
      let newPath = currentPath;

      if (targetLang === 'ru') {
        if (!currentPath.startsWith('/ru')) {
          newPath = '/ru' + (currentPath === '/' ? '' : currentPath);
        }
      } else {
        if (currentPath.startsWith('/ru')) {
          newPath = currentPath.replace(/^\/ru(\/|$)/, '/') || '/';
        }
      }

      window.location.href = newPath + window.location.search + window.location.hash;
    });
  });

  // 3. Active Navigation Highlighting (Scroll Spy & Path Detection)
  const navItems = document.querySelectorAll('.nav-item');
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');
  const productDropdownBtn = document.getElementById('product-dropdown-btn');
  const path = window.location.pathname;

  const activePillClasses = ['bg-cyber-cyan/10', 'text-cyber-cyan', 'font-semibold', 'border', 'border-cyber-cyan/25', 'shadow-sm'];
  const inactiveClasses = ['text-slate-300', 'hover:text-white', 'hover:bg-white/5'];

  function highlightPill(element: HTMLElement | null, isActive: boolean) {
    if (!element) return;
    if (isActive) {
      inactiveClasses.forEach((cls) => element.classList.remove(cls));
      activePillClasses.forEach((cls) => element.classList.add(cls));
    } else {
      activePillClasses.forEach((cls) => element.classList.remove(cls));
      inactiveClasses.forEach((cls) => element.classList.add(cls));
    }
  }

  function setActive(targetId: string | null) {
    // Check if target is inside product dropdown
    const isProductActive = ['features', 'compare', 'sync', 'ai'].includes(targetId || '');
    highlightPill(productDropdownBtn, isProductActive);

    navItems.forEach((link) => {
      if (link.id === 'product-dropdown-btn') return;
      const target = link.getAttribute('data-nav-target');
      highlightPill(link as HTMLElement, target === targetId);
    });

    mobileNavItems.forEach((link) => {
      const target = link.getAttribute('data-nav-target');
      if (target === targetId) {
        link.classList.remove('text-slate-300');
        link.classList.add('text-cyber-cyan', 'font-semibold', 'bg-cyber-cyan/10');
      } else {
        link.classList.remove('text-cyber-cyan', 'font-semibold', 'bg-cyber-cyan/10');
        link.classList.add('text-slate-300');
      }
    });
  }

  if (path.includes('/roadmap')) {
    setActive('roadmap');
  } else if (
    path.includes('/getting-started') ||
    path.includes('/security') ||
    path.includes('/sync') ||
    path.includes('/ai') ||
    path.includes('/plugins') ||
    path.includes('/docs')
  ) {
    setActive('docs');
  } else {
    // Home page sections spy
    const sections = ['features', 'compare', 'sync', 'ai'];
    const sectionElements = sections
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    function updateActiveSection() {
      const scrollPosition = window.scrollY + 250;
      let currentSection: string | null = null;

      for (const section of sectionElements) {
        const top = section.getBoundingClientRect().top + window.scrollY;
        const height = section.offsetHeight;
        if (scrollPosition >= top && scrollPosition < top + height) {
          currentSection = section.id;
          break;
        }
      }

      if (window.scrollY < 300) {
        currentSection = null;
      }

      setActive(currentSection);
    }

    window.addEventListener('scroll', updateActiveSection, { passive: true });
    updateActiveSection();
  }

  // 4. Live GitHub Stars Sync
  try {
    fetch('https://api.github.com/repos/kobaltgit/Shellit')
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (data && typeof data.stargazers_count === 'number') {
          const starDesktop = document.getElementById('github-stars-count');
          if (starDesktop) starDesktop.textContent = String(data.stargazers_count);
          document.querySelectorAll('.github-stars-count-mobile').forEach((el) => {
            el.textContent = String(data.stargazers_count);
          });
        }
      })
      .catch(() => {});
  } catch (_) {}
</script>
