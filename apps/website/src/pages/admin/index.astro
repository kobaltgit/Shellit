---
// Shellit Admin & Analytics Telemetry Dashboard
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shellit Command Center • Admin & Analytics</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      :root {
        --cyber-cyan: #00F0FF;
        --cyber-purple: #A855F7;
        --cyber-green: #22C55E;
        --cyber-blue: #38BDF8;
        --cyber-amber: #F59E0B;
        --cyber-red: #EF4444;
        --obsidian-bg: #0D0F12;
        --obsidian-card: #15181E;
        --obsidian-surface: #1E232B;
        --obsidian-border: #262B35;
      }
      body {
        background-color: var(--obsidian-bg);
        color: #f1f5f9;
        font-family: 'Inter', sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      .shadow-glow-cyan {
        box-shadow: 0 0 20px rgba(0, 240, 255, 0.25);
      }
      .shadow-glow-lime {
        box-shadow: 0 0 20px rgba(123, 225, 19, 0.25);
      }
      .shadow-glow-purple {
        box-shadow: 0 0 20px rgba(168, 85, 247, 0.25);
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 selection:bg-[#7BE113]/20 selection:text-[#8AEB1A]">

    <!-- Auth Guard View (Login Modal when unauthenticated) -->
    <div id="auth-view" class="min-h-screen flex items-center justify-center p-4">
      <div class="relative w-full max-w-md p-8 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-2xl space-y-6">
        <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-24 h-24 bg-cyan-500/20 blur-2xl rounded-full pointer-events-none"></div>

        <div class="text-center space-y-2">
          <div class="w-12 h-12 rounded-xl bg-[#1E232B] border border-[#262B35] flex items-center justify-center mx-auto shadow-glow-cyan">
            <img src="/favicon.svg" alt="Shellit Logo" class="w-7 h-7" />
          </div>
          <h2 class="text-xl font-bold tracking-wide text-white">Shellit Command Center</h2>
          <p class="text-xs text-slate-400 font-mono">Restricted Admin & Analytics Dashboard</p>
        </div>

        <div id="login-error" class="hidden p-3 rounded-xl bg-red-950/40 border border-red-500/50 text-red-400 text-xs font-mono text-center"></div>

        <form id="login-form" class="space-y-4">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1">Superuser Email</label>
            <input
              type="email"
              id="admin-email"
              required
              value="admin@shellit.dev"
              placeholder="admin@shellit.dev"
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#1E232B] border border-[#262B35] text-white text-xs font-mono focus:outline-none focus:border-cyan-400 transition-colors"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1">Password</label>
            <input
              type="password"
              id="admin-password"
              required
              placeholder="••••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#1E232B] border border-[#262B35] text-white text-xs font-mono focus:outline-none focus:border-cyan-400 transition-colors"
            />
          </div>

          <button
            type="submit"
            id="login-btn"
            class="w-full py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs font-mono tracking-wide shadow-glow-cyan transition-all hover:scale-[1.01]"
          >
            Authenticate Session →
          </button>
        </form>

        <div class="text-center pt-2">
          <a href="/" class="text-xs font-mono text-slate-500 hover:text-slate-300 transition-colors">← Return to Shellit Home</a>
        </div>
      </div>
    </div>

    <!-- Authenticated Dashboard View -->
    <div id="dashboard-view" class="hidden min-h-screen flex flex-col">
      <!-- Top Bar -->
      <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#0D0F12]/95 border-b border-[#262B35] px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3 transition-all">
        <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center justify-between gap-3">
          
          <!-- Top Row (Mobile) / Left Group (Desktop): Brand & Live Telemetry -->
          <div class="flex items-center justify-between w-full lg:w-auto gap-3">
            <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
              <div class="w-8 h-8 rounded-lg bg-[#15181E] border border-[#262B35] flex items-center justify-center p-1.5 shadow-glow-lime shrink-0">
                <img src="/favicon.svg" alt="Shellit Logo" class="w-full h-full" />
              </div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-sm sm:text-base tracking-wide text-white whitespace-nowrap">Shellit Analytics</span>
                <span class="px-1.5 py-0.5 text-[9px] font-mono rounded bg-[#7BE113]/10 text-[#8AEB1A] border border-[#7BE113]/30 whitespace-nowrap">PROD</span>
              </div>
            </div>

            <!-- Quick return link (visible on mobile/tablet when controls wrap) -->
            <div class="flex items-center gap-2 lg:hidden">
              <a href="/" class="text-[11px] font-mono text-slate-400 hover:text-white px-2 py-1 rounded bg-[#15181E] border border-[#262B35] transition-colors">
                ← Public Site
              </a>
            </div>
          </div>

          <!-- Bottom Row (Mobile) / Right Group (Desktop): Controls & Actions -->
          <div class="flex items-center flex-wrap gap-2 sm:gap-3 w-full lg:w-auto justify-between lg:justify-end">
            <!-- Time Range Selector -->
            <div class="flex items-center rounded-lg bg-[#15181E] border border-[#262B35] p-0.5 text-xs font-mono shrink-0">
              <button class="range-btn px-2 sm:px-2.5 py-1 rounded transition-colors text-slate-400 hover:text-white text-[11px] sm:text-xs" data-range="today">Today</button>
              <button class="range-btn px-2 sm:px-2.5 py-1 rounded transition-colors bg-[#7BE113]/20 text-[#8AEB1A] font-bold border border-[#7BE113]/40 text-[11px] sm:text-xs" data-range="7d"><span class="sm:hidden">7D</span><span class="hidden sm:inline">7 Days</span></button>
              <button class="range-btn px-2 sm:px-2.5 py-1 rounded transition-colors text-slate-400 hover:text-white text-[11px] sm:text-xs" data-range="30d"><span class="sm:hidden">30D</span><span class="hidden sm:inline">30 Days</span></button>
              <button class="range-btn px-2 sm:px-2.5 py-1 rounded transition-colors text-slate-400 hover:text-white text-[11px] sm:text-xs" data-range="all"><span class="sm:hidden">All</span><span class="hidden sm:inline">All Time</span></button>
            </div>

            <!-- Action buttons cluster -->
            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
              <button
                id="sync-github-btn"
                class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg bg-[#1E232B] border border-[#262B35] hover:border-slate-500 text-slate-200 text-[11px] sm:text-xs font-mono transition-colors shrink-0"
                title="Poll and update GitHub Releases stats"
              >
                <span>🔄</span>
                <span class="hidden md:inline">Sync GitHub</span>
                <span class="md:hidden">Sync</span>
              </button>

              <button
                id="export-csv-btn"
                class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg bg-[#1E232B] border border-[#262B35] hover:border-slate-500 text-slate-200 text-[11px] sm:text-xs font-mono transition-colors shrink-0"
                title="Export analytics and feedback to CSV"
              >
                <span>📥</span>
                <span class="hidden md:inline">Export CSV</span>
                <span class="md:hidden">CSV</span>
              </button>

              <a
                id="pb-admin-btn"
                href="/_/"
                target="_blank"
                class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-lg bg-[#1E232B] border border-[#262B35] hover:border-[#7BE113] text-[#8AEB1A] text-[11px] sm:text-xs font-mono transition-colors shrink-0"
                title="Open PocketBase Admin Panel"
              >
                <span>⚡</span>
                <span class="hidden md:inline">PB Admin</span>
                <span class="md:hidden">PB</span>
              </a>

              <button
                id="logout-btn"
                class="px-2.5 sm:px-3 py-1.5 rounded-lg text-[11px] sm:text-xs font-mono text-red-400 hover:text-red-300 hover:bg-red-950/30 transition-colors shrink-0"
                title="Log out of admin session"
              >
                Logout
              </button>
            </div>
          </div>

        </div>
      </header>

      <!-- Main Dashboard Grid -->
      <main class="flex-grow p-4 sm:p-8 max-w-7xl mx-auto w-full space-y-6">

        <!-- Top Stat Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Metric 1: Total Visits -->
          <div class="p-5 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-lg relative overflow-hidden">
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span>PAGEVIEWS</span>
              <span class="text-cyan-400">● Live</span>
            </div>
            <div class="text-3xl font-extrabold text-white font-mono" id="stat-pageviews">--</div>
            <div class="mt-2 text-[11px] text-slate-400 flex items-center gap-1 font-mono">
              <span class="text-green-400">↑ 18.4%</span> vs prior period
            </div>
          </div>

          <!-- Metric 2: Unique Visitors -->
          <div class="p-5 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-lg relative overflow-hidden">
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span>UNIQUE VISITORS</span>
              <span class="text-purple-400">GDPR-safe</span>
            </div>
            <div class="text-3xl font-extrabold text-white font-mono" id="stat-visitors">--</div>
            <div class="mt-2 text-[11px] text-slate-400 flex items-center gap-1 font-mono">
              <span class="text-green-400">↑ 12.1%</span> unique daily hashes
            </div>
          </div>

          <!-- Metric 3: Total Downloads -->
          <div class="p-5 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-lg relative overflow-hidden">
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span>TOTAL DOWNLOADS</span>
              <span class="text-green-400">GitHub Verified</span>
            </div>
            <div class="text-3xl font-extrabold text-white font-mono" id="stat-downloads">--</div>
            <div class="mt-2 text-[11px] text-slate-400 flex items-center gap-2 font-mono" id="stat-downloads-breakdown">
              <span class="text-cyan-400">Win: --</span> • <span class="text-purple-400">Lin: --</span> • <span class="text-blue-400">APK: --</span>
            </div>
          </div>

          <!-- Metric 4: Feedback / Bug Reports -->
          <div class="p-5 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-lg relative overflow-hidden">
            <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-2">
              <span>INBOX REPORTS</span>
              <span class="text-amber-400 font-bold" id="stat-new-badge">0 NEW</span>
            </div>
            <div class="text-3xl font-extrabold text-white font-mono" id="stat-feedback">--</div>
            <div class="mt-2 text-[11px] text-slate-400 font-mono">
              Feedback & bug submissions
            </div>
          </div>
        </div>

        <!-- Row 1: Charts (Traffic Dynamics & Release Downloads) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Chart 1: Traffic Dynamics (2 cols) -->
          <div class="lg:col-span-2 p-4 sm:p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <h3 class="text-sm font-bold text-white tracking-wide">Traffic & Engagement Velocity</h3>
                <p class="text-xs text-slate-400 font-mono">Pageviews vs Unique Visitors over selected timeframe</p>
              </div>
              <div class="flex items-center gap-4 text-xs font-mono shrink-0">
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-[#7BE113]"></span> Pageviews</span>
                <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span> Unique Visitors</span>
              </div>
            </div>
            <div class="h-64 relative">
              <canvas id="trafficChart"></canvas>
            </div>
          </div>

          <!-- Chart 2: Release Downloads by Version (1 col) -->
          <div class="p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-white tracking-wide">Downloads by Release</h3>
                <p class="text-xs text-slate-400 font-mono">Distribution across builds & OS</p>
              </div>
            </div>
            <div class="h-64 relative">
              <canvas id="releasesChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Row 2: Secondary Charts (Top Pages, OS Distribution, Traffic Referrers) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Top Pages -->
          <div class="p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <h3 class="text-sm font-bold text-white tracking-wide">Top Visited Pages</h3>
            <div class="h-56 relative">
              <canvas id="pagesChart"></canvas>
            </div>
          </div>

          <!-- OS Distribution -->
          <div class="p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <h3 class="text-sm font-bold text-white tracking-wide">Platform & OS Share</h3>
            <div class="h-56 relative">
              <canvas id="osChart"></canvas>
            </div>
          </div>

          <!-- Referrers -->
          <div class="p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <h3 class="text-sm font-bold text-white tracking-wide">Traffic Referrers</h3>
            <div class="h-56 relative">
              <canvas id="referrerChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Row 3: Roadmap Live Pulse & Feedback Reports Inbox -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Roadmap Top Requested Features (1 col) -->
          <div class="p-4 sm:p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-bold text-white tracking-wide truncate">Community Feature Votes</h3>
              <a href="/roadmap" target="_blank" class="text-xs font-mono text-[#8AEB1A] hover:underline shrink-0">View Public →</a>
            </div>
            <div id="roadmap-top-list" class="space-y-3 font-mono text-xs">
              <div class="text-slate-500">Loading roadmap metrics...</div>
            </div>
          </div>

          <!-- Feedback & Bug Reports Manager (2 cols) -->
          <div class="lg:col-span-2 p-4 sm:p-6 rounded-2xl bg-[#15181E] border border-[#262B35] shadow-xl space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-bold text-white tracking-wide">User Inbound Reports <span class="text-xs font-mono text-slate-400 font-normal">(`feedback_reports`)</span></h3>
                <p class="text-xs text-slate-400 font-mono">Bugs, feature inquiries and community suggestions</p>
              </div>
              <div class="flex items-center flex-wrap gap-1.5 text-xs font-mono shrink-0">
                <button class="fb-filter-btn px-2.5 py-1 rounded bg-[#7BE113]/20 text-[#8AEB1A] font-bold border border-[#7BE113]/40" data-status="all">All</button>
                <button class="fb-filter-btn px-2.5 py-1 rounded text-slate-400 hover:text-white border border-transparent" data-status="new">New</button>
                <button class="fb-filter-btn px-2.5 py-1 rounded text-slate-400 hover:text-white border border-transparent" data-status="in_progress">In Progress</button>
                <button class="fb-filter-btn px-2.5 py-1 rounded text-slate-400 hover:text-white border border-transparent" data-status="resolved">Resolved</button>
              </div>
            </div>

            <div id="feedback-list" class="space-y-3 max-h-80 overflow-y-auto pr-1 font-mono text-xs">
              <div class="text-slate-500">Loading user reports...</div>
            </div>
          </div>

        </div>

      </main>

      <!-- Admin Responsive Footer (Подвал) -->
      <footer class="mt-auto border-t border-[#262B35] bg-[#0D0F12]/80 backdrop-blur-md px-4 sm:px-8 py-5">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-500">
          <div class="flex items-center gap-2.5">
            <span class="inline-block w-2 h-2 rounded-full bg-[#7BE113] animate-pulse"></span>
            <span class="text-slate-300 font-semibold">Shellit Command Center</span>
            <span class="text-slate-600">•</span>
            <span class="text-slate-400">Node Senko</span>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-[11px]">
            <a href="/" class="hover:text-[#8AEB1A] transition-colors">Portal Home</a>
            <span class="text-slate-700">•</span>
            <a href="/roadmap" class="hover:text-[#8AEB1A] transition-colors">Roadmap Pulse</a>
            <span class="text-slate-700">•</span>
            <a href="https://github.com/kobaltgit/Shellit" target="_blank" rel="noopener noreferrer" class="hover:text-[#8AEB1A] transition-colors">GitHub Repository</a>
            <span class="text-slate-700">•</span>
            <a href="/_/" target="_blank" class="text-cyan-400 hover:text-cyan-300 transition-colors">PB Engine</a>
          </div>

          <div class="text-[11px] text-slate-500 text-center md:text-right">
            Zero-Knowledge Security • Drift/SQLCipher Engine
          </div>
        </div>
      </footer>
    </div>

    <!-- Client-Side Dashboard Controller Script -->
    <script is:inline>
      const PB_URL = window.__PUBLIC_POCKETBASE_URL__ || window.location.origin;
      const pbBtn = document.getElementById('pb-admin-btn');
      if (pbBtn) pbBtn.href = PB_URL + '/_/';
      let adminToken = localStorage.getItem('shellit_admin_token') || '';
      let currentRange = '7d';
      let currentFbFilter = 'all';

      let allVisits = [];
      let allReleases = [];
      let allRoadmap = [];
      let allFeedback = [];

      // Chart Instances
      let trafficChart = null;
      let releasesChart = null;
      let pagesChart = null;
      let osChart = null;
      let referrerChart = null;

      const authView = document.getElementById('auth-view');
      const dashboardView = document.getElementById('dashboard-view');
      const loginForm = document.getElementById('login-form');
      const loginError = document.getElementById('login-error');
      const logoutBtn = document.getElementById('logout-btn');

      // 1. Auth Handling
      async function initAuth() {
        if (!adminToken) {
          showAuth();
          return;
        }

        try {
          // Verify token validity by requesting superuser profile
          const res = await fetch(`${PB_URL}/api/collections/_superusers/auth-refresh`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': adminToken
            }
          });

          if (res.ok) {
            const data = await res.json();
            adminToken = data.token;
            localStorage.setItem('shellit_admin_token', adminToken);
            showDashboard();
            loadAllData();
          } else {
            logout();
          }
        } catch (err) {
          // If server offline or bad token
          showAuth();
        }
      }

      function showAuth() {
        authView.classList.remove('hidden');
        dashboardView.classList.add('hidden');
      }

      function showDashboard() {
        authView.classList.add('hidden');
        dashboardView.classList.remove('hidden');
      }

      function logout() {
        adminToken = '';
        localStorage.removeItem('shellit_admin_token');
        showAuth();
      }

      if (logoutBtn) logoutBtn.addEventListener('click', logout);

      if (loginForm) {
        loginForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          loginError.classList.add('hidden');
          const email = document.getElementById('admin-email').value;
          const password = document.getElementById('admin-password').value;

          try {
            const res = await fetch(`${PB_URL}/api/collections/_superusers/auth-with-password`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ identity: email, password: password })
            });

            const data = await res.json();
            if (res.ok && data.token) {
              adminToken = data.token;
              localStorage.setItem('shellit_admin_token', adminToken);
              showDashboard();
              loadAllData();
            } else {
              loginError.textContent = data.message || 'Invalid superuser credentials.';
              loginError.classList.remove('hidden');
            }
          } catch (err) {
            loginError.textContent = 'Connection error: ' + (err.message || 'Cannot reach PocketBase backend');
            loginError.classList.remove('hidden');
          }
        });
      }

      // 2. Data Fetching
      async function loadAllData() {
        await Promise.all([
          fetchVisits(),
          fetchReleases(),
          fetchRoadmap(),
          fetchFeedback()
        ]);
        renderDashboard();
      }

      async function fetchVisits() {
        try {
          let res = await fetch(`${PB_URL}/api/collections/site_visits/records?perPage=500&sort=-created`, {
            headers: { 'Authorization': adminToken }
          });
          if (!res.ok) {
            res = await fetch(`${PB_URL}/api/collections/site_visits/records?perPage=500`, {
              headers: { 'Authorization': adminToken }
            });
          }
          if (res.ok) {
            const d = await res.json();
            allVisits = d.items || [];
          }
        } catch (e) {
          allVisits = [];
        }
      }

      async function fetchReleases() {
        try {
          let res = await fetch(`${PB_URL}/api/collections/release_snapshots/records?perPage=50&sort=-created`, {
            headers: { 'Authorization': adminToken }
          });
          if (!res.ok) {
            res = await fetch(`${PB_URL}/api/collections/release_snapshots/records?perPage=50`, {
              headers: { 'Authorization': adminToken }
            });
          }
          if (res.ok) {
            const d = await res.json();
            allReleases = d.items || [];
          }
        } catch (e) {
          allReleases = [];
        }
      }

      async function fetchRoadmap() {
        try {
          const res = await fetch(`${PB_URL}/api/collections/roadmap_items/records?perPage=50&sort=-votes`);
          if (res.ok) {
            const d = await res.json();
            allRoadmap = d.items || [];
          }
        } catch (e) {
          allRoadmap = [];
        }
      }

      async function fetchFeedback() {
        try {
          let res = await fetch(`${PB_URL}/api/collections/feedback_reports/records?perPage=100&sort=-created`, {
            headers: { 'Authorization': adminToken }
          });
          if (!res.ok) {
            res = await fetch(`${PB_URL}/api/collections/feedback_reports/records?perPage=100`, {
              headers: { 'Authorization': adminToken }
            });
          }
          if (res.ok) {
            const d = await res.json();
            allFeedback = d.items || [];
          }
        } catch (e) {
          allFeedback = [];
        }
      }

      // 3. Render Dashboard Metrics & Charts
      function renderDashboard() {
        renderMetricCards();
        renderTrafficChart();
        renderReleasesChart();
        renderPagesChart();
        renderOsChart();
        renderReferrerChart();
        renderRoadmapList();
        renderFeedbackList();
      }

      function parseRecordDate(dateStr) {
        if (!dateStr) return null;
        const iso = dateStr.includes('T') ? dateStr : dateStr.replace(' ', 'T');
        const d = new Date(iso);
        return isNaN(d.getTime()) ? null : d;
      }

      function filterVisitsByRange() {
        const now = new Date();
        const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

        return allVisits.filter((v) => {
          const created = parseRecordDate(v.created);
          if (!created) return true;
          const time = created.getTime();

          if (currentRange === 'today') {
            return time >= startOfToday;
          } else if (currentRange === '7d') {
            return (now.getTime() - time) <= 7 * 24 * 3600 * 1000;
          } else if (currentRange === '30d') {
            return (now.getTime() - time) <= 30 * 24 * 3600 * 1000;
          }
          return true; // all
        });
      }

      function renderMetricCards() {
        const filteredVisits = filterVisitsByRange();
        const pageviews = filteredVisits.length;
        const uniqueVisitors = new Set(filteredVisits.map((v) => v.visitor_hash)).size;

        const totalWin = allReleases.reduce((acc, r) => acc + (r.windows_downloads || 0), 0);
        const totalLin = allReleases.reduce((acc, r) => acc + (r.linux_downloads || 0), 0);
        const totalApk = allReleases.reduce((acc, r) => acc + (r.android_downloads || 0), 0);
        const totalDownloads = totalWin + totalLin + totalApk;

        const winPct = totalDownloads > 0 ? Math.round((totalWin / totalDownloads) * 100) : 0;
        const linPct = totalDownloads > 0 ? Math.round((totalLin / totalDownloads) * 100) : 0;
        const apkPct = totalDownloads > 0 ? Math.round((totalApk / totalDownloads) * 100) : 0;

        const newReports = allFeedback.filter((f) => f.status === 'new').length;

        document.getElementById('stat-pageviews').textContent = pageviews.toLocaleString();
        document.getElementById('stat-visitors').textContent = uniqueVisitors.toLocaleString();
        document.getElementById('stat-downloads').textContent = totalDownloads.toLocaleString();
        const breakdownEl = document.getElementById('stat-downloads-breakdown');
        if (breakdownEl) {
          breakdownEl.innerHTML = `<span class="text-cyan-400">Win: ${winPct}% (${totalWin})</span> • <span class="text-purple-400">Lin: ${linPct}% (${totalLin})</span> • <span class="text-blue-400">APK: ${apkPct}% (${totalApk})</span>`;
        }
        document.getElementById('stat-feedback').textContent = allFeedback.length.toString();
        document.getElementById('stat-new-badge').textContent = `${newReports} NEW`;
      }

      // Chart 1: Traffic Chart
      function renderTrafficChart() {
        const ctx = document.getElementById('trafficChart').getContext('2d');
        const visits = filterVisitsByRange();

        const labels = [];
        const daysMap = {};

        if (currentRange === 'today') {
          // Hour slots throughout today: 00:00, 03:00, 06:00, 09:00, 12:00, 15:00, 18:00, 21:00
          for (let h = 0; h < 24; h += 3) {
            const key = String(h).padStart(2, '0') + ':00';
            labels.push(key);
            daysMap[key] = { views: 0, uniques: new Set() };
          }

          visits.forEach((v) => {
            const d = parseRecordDate(v.created);
            if (!d) return;
            const h = Math.floor(d.getHours() / 3) * 3;
            const key = String(h).padStart(2, '0') + ':00';
            if (daysMap[key]) {
              daysMap[key].views++;
              daysMap[key].uniques.add(v.visitor_hash || v.id);
            }
          });
        } else {
          // 7 days or 30 days
          const daysCount = currentRange === '30d' ? 30 : currentRange === 'all' ? 14 : 7;
          for (let i = daysCount - 1; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);
            const key = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            labels.push(key);
            daysMap[key] = { views: 0, uniques: new Set() };
          }

          visits.forEach((v) => {
            const d = parseRecordDate(v.created);
            if (!d) return;
            const key = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            if (daysMap[key]) {
              daysMap[key].views++;
              daysMap[key].uniques.add(v.visitor_hash || v.id);
            }
          });
        }

        const viewsData = labels.map((k) => daysMap[k]?.views || 0);
        const uniquesData = labels.map((k) => daysMap[k]?.uniques.size || 0);

        if (trafficChart) trafficChart.destroy();
        trafficChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels,
            datasets: [
              {
                label: 'Pageviews',
                data: viewsData,
                borderColor: '#7BE113',
                backgroundColor: 'rgba(123, 225, 19, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.35
              },
              {
                label: 'Unique Visitors',
                data: uniquesData,
                borderColor: '#A855F7',
                backgroundColor: 'rgba(168, 85, 247, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.35
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { grid: { color: '#1E232B' }, ticks: { color: '#64748B', font: { family: 'JetBrains Mono', size: 10 } } },
              y: { grid: { color: '#1E232B' }, ticks: { color: '#64748B', font: { family: 'JetBrains Mono', size: 10 }, stepSize: 1 } }
            }
          }
        });
      }

      // Chart 2: Releases Chart
      function renderReleasesChart() {
        const ctx = document.getElementById('releasesChart').getContext('2d');
        // Show releases with downloads or active latest versions, sorted chronologically
        const activeReleases = allReleases
          .filter((r, idx) => (r.total_downloads || 0) > 0 || idx === 0)
          .slice(0, 10);

        activeReleases.sort((a, b) => a.tag_name.localeCompare(b.tag_name, undefined, { numeric: true }));

        const labels = activeReleases.map((r) => r.tag_name);
        const winData = activeReleases.map((r) => r.windows_downloads || 0);
        const linData = activeReleases.map((r) => r.linux_downloads || 0);
        const apkData = activeReleases.map((r) => r.android_downloads || 0);

        if (releasesChart) releasesChart.destroy();
        releasesChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels,
            datasets: [
              { label: 'Windows', data: winData, backgroundColor: '#7BE113' },
              { label: 'Linux', data: linData, backgroundColor: '#A855F7' },
              { label: 'Android APK', data: apkData, backgroundColor: '#38BDF8' }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                labels: { color: '#94A3B8', font: { family: 'JetBrains Mono', size: 10 } }
              }
            },
            scales: {
              x: { stacked: true, grid: { color: '#1E232B' }, ticks: { color: '#64748B', font: { family: 'JetBrains Mono', size: 10 } } },
              y: { stacked: true, grid: { color: '#1E232B' }, ticks: { color: '#64748B', font: { family: 'JetBrains Mono', size: 10 } } }
            }
          }
        });
      }

      // Chart 3: Top Pages
      function renderPagesChart() {
        const ctx = document.getElementById('pagesChart').getContext('2d');
        const visits = filterVisitsByRange();
        const countMap = {};
        visits.forEach((v) => {
          countMap[v.path] = (countMap[v.path] || 0) + 1;
        });

        const sorted = Object.entries(countMap).sort((a, b) => b[1] - a[1]).slice(0, 5);
        const labels = sorted.map((s) => s[0]);
        const data = sorted.map((s) => s[1]);

        if (pagesChart) pagesChart.destroy();
        pagesChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels,
            datasets: [{ data, backgroundColor: '#38BDF8', borderRadius: 4 }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { grid: { color: '#1E232B' }, ticks: { color: '#64748B', font: { family: 'JetBrains Mono', size: 9 } } },
              y: { grid: { display: false }, ticks: { color: '#94A3B8', font: { family: 'JetBrains Mono', size: 9 } } }
            }
          }
        });
      }

      // Chart 4: OS Chart
      function renderOsChart() {
        const ctx = document.getElementById('osChart').getContext('2d');
        const visits = filterVisitsByRange();
        const osMap = {};
        visits.forEach((v) => {
          const os = v.os || 'Other';
          osMap[os] = (osMap[os] || 0) + 1;
        });

        const labels = Object.keys(osMap);
        const data = Object.values(osMap);

        if (osChart) osChart.destroy();
        osChart = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels,
            datasets: [{ data, backgroundColor: ['#00F0FF', '#A855F7', '#22C55E', '#38BDF8', '#64748B'], borderWidth: 0 }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'right', labels: { color: '#94A3B8', font: { family: 'JetBrains Mono', size: 10 } } }
            }
          }
        });
      }

      // Chart 5: Referrer Chart
      function renderReferrerChart() {
        const ctx = document.getElementById('referrerChart').getContext('2d');
        const visits = filterVisitsByRange();
        const refMap = {};
        visits.forEach((v) => {
          let ref = v.referrer || 'direct';
          if (ref.includes('github')) ref = 'GitHub';
          else if (ref.includes('google')) ref = 'Google';
          else if (ref.includes('t.me') || ref.includes('telegram')) ref = 'Telegram';
          else if (ref.includes('reddit')) ref = 'Reddit';
          else if (ref === 'direct') ref = 'Direct';
          else ref = 'Other';

          refMap[ref] = (refMap[ref] || 0) + 1;
        });

        const labels = Object.keys(refMap);
        const data = Object.values(refMap);

        if (referrerChart) referrerChart.destroy();
        referrerChart = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels,
            datasets: [{ data, backgroundColor: ['#22C55E', '#00F0FF', '#A855F7', '#F59E0B', '#64748B'], borderWidth: 0 }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'right', labels: { color: '#94A3B8', font: { family: 'JetBrains Mono', size: 10 } } }
            }
          }
        });
      }

      // Roadmap Pulse
      function renderRoadmapList() {
        const container = document.getElementById('roadmap-top-list');
        if (!container) return;
        const top5 = allRoadmap.slice(0, 5);

        container.innerHTML = top5.map((item, idx) => `
          <div class="flex items-center justify-between p-2.5 rounded-xl bg-[#1E232B] border border-[#262B35]">
            <div class="truncate max-w-[200px]">
              <span class="text-slate-500 mr-1">#${idx + 1}</span>
              <span class="text-slate-200 font-semibold">${item.title_en || item.feature_id}</span>
            </div>
            <div class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#7BE113]/10 text-[#8AEB1A] border border-[#7BE113]/30 font-bold shrink-0">
              <span>▲</span>
              <span>${item.votes || 0}</span>
            </div>
          </div>
        `).join('');
      }

      // Feedback Inbox Manager
      function renderFeedbackList() {
        const container = document.getElementById('feedback-list');
        if (!container) return;

        const filtered = allFeedback.filter((f) => {
          if (currentFbFilter === 'all') return true;
          return f.status === currentFbFilter;
        });

        if (filtered.length === 0) {
          container.innerHTML = `<div class="p-4 text-slate-500 text-center">No reports matching filter "${currentFbFilter}".</div>`;
          return;
        }

        container.innerHTML = filtered.map((fb) => {
          const badgeClass = fb.status === 'new'
            ? 'bg-amber-500/20 text-amber-400 border-amber-500/40'
            : fb.status === 'in_progress'
            ? 'bg-[#7BE113]/20 text-[#8AEB1A] border-[#7BE113]/40'
            : 'bg-green-500/20 text-green-400 border-green-500/40';

          return `
            <div class="p-3.5 rounded-xl bg-[#1E232B] border border-[#262B35] space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1.5 sm:gap-2">
                <div class="min-w-0 flex-1">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold border ${badgeClass} uppercase inline-block">${fb.status}</span>
                  <span class="font-bold text-slate-200 ml-2 break-words">${escapeHtml(fb.subject || 'No Subject')}</span>
                </div>
                <span class="text-[10px] text-slate-500 shrink-0 whitespace-nowrap">${new Date(fb.created).toLocaleDateString()}</span>
              </div>
              <p class="text-[11px] text-slate-400 leading-relaxed font-sans break-words">${escapeHtml(fb.message || '')}</p>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[10px] text-slate-500 pt-1.5 border-t border-[#262B35]">
                <span class="truncate">User: ${fb.email ? escapeHtml(fb.email) : 'Anonymous'} • ${fb.os_info ? escapeHtml(fb.os_info.slice(0, 30)) : ''}</span>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${fb.status !== 'in_progress' ? `<button onclick="updateFbStatus('${fb.id}', 'in_progress')" class="px-2 py-0.5 rounded bg-[#15181E] hover:bg-slate-800 border border-[#7BE113]/40 text-[#8AEB1A] transition-colors">In Progress</button>` : ''}
                  ${fb.status !== 'resolved' ? `<button onclick="updateFbStatus('${fb.id}', 'resolved')" class="px-2 py-0.5 rounded bg-[#15181E] hover:bg-slate-800 border border-green-700/50 text-green-300 transition-colors">Resolve</button>` : ''}
                </div>
              </div>
            </div>
          `;
        }).join('');
      }

      window.updateFbStatus = async function (id, status) {
        try {
          const res = await fetch(`${PB_URL}/api/collections/feedback_reports/records/${id}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': adminToken
            },
            body: JSON.stringify({ status })
          });
          if (res.ok) {
            await fetchFeedback();
            renderMetricCards();
            renderFeedbackList();
          }
        } catch (e) {
          alert('Failed to update status');
        }
      };

      function escapeHtml(str) {
        return (str || '').replace(/[&<>'"]/g, 
          tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
        );
      }

      // Range Filter Buttons
      document.querySelectorAll('.range-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.range-btn').forEach((b) => {
            b.classList.remove('bg-[#7BE113]/20', 'text-[#8AEB1A]', 'font-bold', 'border', 'border-[#7BE113]/40', 'bg-cyan-500/20', 'text-cyan-400', 'border-cyan-500/40');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('bg-[#7BE113]/20', 'text-[#8AEB1A]', 'font-bold', 'border', 'border-[#7BE113]/40');
          btn.classList.remove('text-slate-400');

          currentRange = btn.getAttribute('data-range') || '7d';
          renderDashboard();
        });
      });

      // Feedback Filter Buttons
      document.querySelectorAll('.fb-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.fb-filter-btn').forEach((b) => {
            b.classList.remove('bg-[#7BE113]/20', 'text-[#8AEB1A]', 'font-bold', 'border', 'border-[#7BE113]/40', 'bg-cyan-500/20', 'text-cyan-400', 'border-cyan-500/40');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('bg-[#7BE113]/20', 'text-[#8AEB1A]', 'font-bold', 'border', 'border-[#7BE113]/40');
          btn.classList.remove('text-slate-400');

          currentFbFilter = btn.getAttribute('data-status') || 'all';
          renderFeedbackList();
        });
      });

      // Export CSV
      document.getElementById('export-csv-btn')?.addEventListener('click', () => {
        const rows = [
          ['Type', 'ID', 'Field1', 'Field2', 'Created'],
          ...allVisits.map(v => ['Visit', v.id, v.path, v.os, v.created]),
          ...allFeedback.map(f => ['Feedback', f.id, f.status, f.subject, f.created])
        ];
        const csvContent = 'data:text/csv;charset=utf-8,' + rows.map(e => e.join(',')).join('\n');
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', `shellit_analytics_export_${new Date().toISOString().slice(0, 10)}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });

      // GitHub Sync Handler
      document.getElementById('sync-github-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('sync-github-btn');
        btn.textContent = '⏳ Syncing...';
        btn.disabled = true;

        try {
          // Poll GitHub API
          const ghRes = await fetch('https://api.github.com/repos/kobaltgit/Shellit/releases');
          if (ghRes.ok) {
            const releases = await ghRes.json();
            for (const rel of releases) {
              const tag = rel.tag_name;
              let win = 0, lin = 0, apk = 0;
              const detail = {};

              (rel.assets || []).forEach(a => {
                const count = a.download_count || 0;
                detail[a.name] = count;
                if (a.name.endsWith('.msi') || a.name.endsWith('.zip') || a.name.endsWith('.exe')) win += count;
                else if (a.name.endsWith('.deb') || a.name.endsWith('.AppImage') || a.name.endsWith('.tar.gz')) lin += count;
                else if (a.name.endsWith('.apk')) apk += count;
              });

              const total = win + lin + apk;

              // Check if snapshot exists in PB
              const pbCheck = await fetch(`${PB_URL}/api/collections/release_snapshots/records?filter=(tag_name='${tag}')`, {
                headers: { 'Authorization': adminToken }
              });

              if (pbCheck.ok) {
                const checkData = await pbCheck.json();
                const existing = checkData.items?.[0];
                if (existing) {
                  await fetch(`${PB_URL}/api/collections/release_snapshots/records/${existing.id}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'Authorization': adminToken },
                    body: JSON.stringify({ total_downloads: total, windows_downloads: win, linux_downloads: lin, android_downloads: apk, assets_detail: detail })
                  });
                } else {
                  await fetch(`${PB_URL}/api/collections/release_snapshots/records`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': adminToken },
                    body: JSON.stringify({ tag_name: tag, total_downloads: total, windows_downloads: win, linux_downloads: lin, android_downloads: apk, assets_detail: detail })
                  });
                }
              }
            }
          }
          await fetchReleases();
          renderMetricCards();
          renderReleasesChart();
          alert('GitHub Releases data successfully synchronized!');
        } catch (err) {
          alert('Error during GitHub sync: ' + err.message);
        } finally {
          btn.textContent = '🔄 Sync GitHub';
          btn.disabled = false;
        }
      });

      initAuth();
    </script>
  </body>
</html>
