**/*.vcxproj.user
**/*.vcxproj.filters
**/*.vcxproj.idb
**/*.vcxproj.pdb

# ------------------------------------------------------------------------------
# Linux Platform Artifacts
# ------------------------------------------------------------------------------
**/linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# Security, Secrets & Sensitive Credentials
# Zero Credentials Leakage Protocol
# ------------------------------------------------------------------------------
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
known_hosts
authorized_keys

# Local Databases and SQLCipher Test Dumps
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

