# ==============================================================================
# Shellit — Git Ignore Configuration (Flutter & Dart Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dart & Flutter Build Artifacts and Caches
# ------------------------------------------------------------------------------
**/.dart_tool/
**/build/
**/.pub/
**/.pub-cache/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/coverage/
**/doc/api/
**/.packages

# Symbolication & Obfuscation
**/app.*.symbols
**/app.*.map.json

# ------------------------------------------------------------------------------
# Operating System & File System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*$*
*~

# ------------------------------------------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
# JetBrains / Android Studio
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/
**/.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Editors miscellaneous
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.atom/

